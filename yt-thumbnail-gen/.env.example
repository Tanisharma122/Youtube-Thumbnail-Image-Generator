# FLUX Image Generation Configuration
# Options: "cloud" (recommended, uses HF Serverless API) or "local" (requires GPU + 24GB download)
FLUX_MODE=cloud

# Hugging Face Access Token (Free, required for Cloud mode)
# Generate one at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: custom TTF font path
OVERLAY_FONT_PATH=
